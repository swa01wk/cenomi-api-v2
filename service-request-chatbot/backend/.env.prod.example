# ─────────────────────────────────────────────────────────────────────────────
# Production environment template
# Copy to .env.prod and fill in all values before deploying.
# NEVER commit .env.prod — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME=cenomi-rdd-chatbot-api
ENVIRONMENT=production
DEBUG=false

# CORS — set to your frontend domain
CORS_ORIGINS=https://your-frontend-domain.com

# Database — injected by docker-compose.prod.yml from POSTGRES_* vars
# Leave blank here; docker-compose overrides this with the internal hostname
DATABASE_URL=

# Redis — injected by docker-compose.prod.yml
REDIS_URL=

# ── Cenomi MSP Platform APIs ──────────────────────────────────────────────────
# Create SR + lease lookup forward the inbound AI session Bearer as the acting
# user (agentic-handover routes); no service-account login email required.
# PLATFORM_AUTH_BASE_URL / PLATFORM_INTERNAL_API_TOKEN are only for non-agentic
# S2S calls (PATCH/GET/files).
SERVICE_REQUEST_API_BASE_URL=https://<msp-platform-host>
LEASE_TENANT_API_BASE_URL=https://<msp-platform-host>
PLATFORM_AUTH_BASE_URL=https://<msp-platform-host>
PLATFORM_INTERNAL_API_TOKEN=<platform-internal-token>

# ── MSP Service-to-Service Auth ───────────────────────────────────────────────
# Shared secret between MSP frontend and this chatbot backend
MSP_SERVICE_TOKEN=<agreed-service-token>

# ── User JWT (set to MSP platform signing key after integration) ──────────────
JWT_SECRET_KEY=<strong-random-secret-min-32-chars>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
RBAC_ENFORCE=true

# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_CONFIDENCE_THRESHOLD=0.6

# ── RAG / FAQ Search ─────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
SEARCH_PROVIDER=azure_search
AZURE_SEARCH_ENDPOINT=https://<instance>.search.windows.net
AZURE_SEARCH_API_KEY=<key>
AZURE_SEARCH_INDEX_NAME=cenomi-help-index
