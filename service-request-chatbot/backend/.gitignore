# Python cache
__pycache__/
*.py[cod]
*.pyo

# Virtual environment
.venv/
venv/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Environment — contains secrets, never commit
.env
.env.local
!.env.example

# Test result output files and eval session exports
results/
sessions/
eval_report_*.json
_dump_scenarios.py
_dump_lifecycle.py

# Distribution
*.egg-info/
dist/
build/

# Alembic — do not commit generated migration auto-backups
alembic/versions/__pycache__/

# Indexer record dumps (python -m app.indexer.cli --dump-dir ...).
# These contain real rows copied out of the Cenomi platform database —
# staff names, email addresses and phone numbers. Never commit them.
indexer-dump/
*.rows.jsonl
*.docs.jsonl
