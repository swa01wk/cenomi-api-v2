# RAG Knowledge Indexer job image (ticket 3547).
# Build context MUST be service-request-chatbot/backend (this directory).
#
# Runs as an Azure Container App JOB — no server, no port, no healthcheck.
# Alembic is NOT copied: the API image applies migration 006; this job only
# reads/writes the already-migrated indexer_watermarks table.
#
# Build args:
#   GIT_SHA — short revision, exposed via APP_GIT_SHA env
#   VERSION — exposed via APP_VERSION env
# Example:
#   docker build -f Dockerfile.indexer \
#     --build-arg GIT_SHA=$(git rev-parse --short HEAD) \
#     --build-arg VERSION=$(git describe --tags --always --dirty 2>/dev/null || echo dev) \
#     -t sr-chatbot-indexer .
#
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY app ./app

RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir ".[indexer]"

FROM python:3.11-slim

ARG GIT_SHA=unknown
ARG VERSION=dev
ENV APP_GIT_SHA=${GIT_SHA}
ENV APP_VERSION=${VERSION}

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY app ./app

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# A mode argument is ALWAYS passed: the scheduled job runs the default
# --incremental; the manual full-rebuild job overrides args with ["--full"].
ENTRYPOINT ["python", "-m", "app.indexer.cli"]
CMD ["--incremental"]
