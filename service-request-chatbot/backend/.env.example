# Application
APP_NAME=service-request-chatbot-api
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# CORS (comma-separated origins) — include frontend port (Nx often uses :4200)
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Database (async SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/service_request_chatbot

# Redis
REDIS_URL=redis://localhost:6379/0

# External integrations — set these to activate real platform mode (leave blank for mock mode)
# SERVICE_REQUEST_API_BASE_URL  → POST /service-requests, PATCH, GET, PUT /files
# LEASE_TENANT_API_BASE_URL     → GET /leases (separate lease/tenant service)
# FILE_UPLOAD_API_BASE_URL      → Reserved/future use; uploads currently use SERVICE_REQUEST_API_BASE_URL + /files
SERVICE_REQUEST_API_BASE_URL=
LEASE_TENANT_API_BASE_URL=
# Optional Tenant Central base URL for deep-linking to existing SR details
# (e.g. https://tenant-central.example.com). Relative paths used when blank.
TENANT_PORTAL_BASE_URL=
FILE_UPLOAD_API_BASE_URL=

# Platform service-to-service auth (Cenomi platform login via POST /cenomi-ai/login)
# Create SR, GET /service-requests/{id} (status sync), and lease lookup forward
# the inbound AI session Bearer as the logged-in user (agentic-handover routes)
# and do NOT require a login email.
# The vars below are only used for non-agentic S2S calls (PATCH/files).
# PLATFORM_AUTH_BASE_URL defaults to SERVICE_REQUEST_API_BASE_URL when blank.
PLATFORM_AUTH_BASE_URL=
PLATFORM_INTERNAL_API_TOKEN=

# Security (replace in production)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# RBAC enforcement: false = shadow mode (warn + pass through); true = reject unauthenticated
RBAC_ENFORCE=false

# LLM / AI (required in production)
# LLM backend: "openai" (default) | "azure_openai" | "vertex_ai"
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_CONFIDENCE_THRESHOLD=0.6

# ── RAG / FAQ Hybrid Search ────────────────────────────────────────────────────
# Option A — Standard OpenAI embeddings (default, reuses OPENAI_API_KEY above)
# Only SEARCH_PROVIDER + AZURE_SEARCH_* vars needed; EMBEDDING_PROVIDER can be omitted.
#
# Option B — Azure OpenAI embeddings: set EMBEDDING_PROVIDER=azure_openai and fill AZURE_AI_* vars.
#
# Option C — Vertex AI embeddings: set EMBEDDING_PROVIDER=vertex_ai and fill VERTEX_AI_* vars.
# Reuses the same VERTEX_AI_* vars as LLM_PROVIDER=vertex_ai if both are configured.
#
# Option D — No RAG: leave all vars below blank; faq_node falls back to static FAQ prompt silently.

# Embedding backend: "openai" (default) | "azure_openai" | "vertex_ai"
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Optional: override the OpenAI-compatible embedding endpoint base URL (Option A only)
EMBEDDING_BASE_URL=

# Search backend: "azure_search" (only current implementation)
SEARCH_PROVIDER=

# Azure AI Search — required when SEARCH_PROVIDER=azure_search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=

# Azure OpenAI embeddings — required only when EMBEDDING_PROVIDER=azure_openai
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_API_VERSION=2024-02-15-preview

# ── LLM / Embedding — Google Cloud Vertex AI ───────────────────────────────────
# Shared by LLM_PROVIDER=vertex_ai and/or EMBEDDING_PROVIDER=vertex_ai.
# VERTEX_AI_PROJECT=my-gcp-project
# VERTEX_AI_LOCATION=us-central1
# VERTEX_AI_CREDENTIALS_PATH=/path/to/service-account.json
# LLM model (when LLM_PROVIDER=vertex_ai):
# LLM_MODEL=gemini-2.5-flash
# Embedding model (when EMBEDDING_PROVIDER=vertex_ai):
# VERTEX_AI_EMBEDDING_MODEL=text-embedding-005
